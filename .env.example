# Skopiuj do pliku .env i zmień, co potrzebujesz. Wszystkie wartości są opcjonalne.

# Lotnisko otwierane domyślnie w zakładce AERODROME
VPANDORA_DEFAULT_AERODROME=EPWA

# Źródło METAR: vatsim (metar.vatsim.net) albo awc (aviationweather.gov)
VPANDORA_METAR_SOURCE=vatsim

# Linki do eAIP (zmieniaj przy nowym AIRAC)
#VPANDORA_AIP_IFR_URL=https://docs.pansa.pl/ais/eaipifr/AIRAC%20AMDT%2010-26_2026_10_01/index-v2.html
#VPANDORA_AIP_VFR_URL=https://docs.pansa.pl/ais/eaipvfr/AIRAC%20AMDT%20VFR%2010-26_2026_10_01/index-v2.html
#VPANDORA_AIP_MIL_URL=https://docs.pansa.pl/ais/eaipmil/AIRAC%20AMDT%20MIL%2010-26_2026_10_01/index-v2.html

# Serwer NOTAM PL vACC
#VPANDORA_NOTAM_SERVER=https://cv.plvacc.pl/
#VPANDORA_NOTAM_PREFIX=notam/get-icao-format?icao=
#VPANDORA_NOTAM_SUFFIX=&read=true

# Nakładka lotnicza na mapie (darmowy klucz z https://www.openaip.net)
#VPANDORA_OPENAIP_API_KEY=

# Klucz CARTO do podkładów mapy (ciemny / jasny), darmowy z https://carto.com/basemaps/apikey.
# Bez klucza CARTO dodaje znak wodny, więc aplikacja używa wtedy szarego podkładu Esri.
# Wpisz go tylko tutaj, w lokalnym pliku .env (jest w .gitignore), nigdy w repozytorium.
#VPANDORA_CARTO_API_KEY=
