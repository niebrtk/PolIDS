# Skopiuj do pliku .env i zmień, co potrzebujesz. Wszystkie wartości są opcjonalne. Stary prefiks VPANDORA_ też działa.

# Lotnisko otwierane domyślnie w zakładce AERODROME
POLIDS_DEFAULT_AERODROME=EPWA

# Źródło METAR: vatsim (metar.vatsim.net) albo awc (aviationweather.gov)
POLIDS_METAR_SOURCE=vatsim

# Linki do eAIP (zmieniaj przy nowym AIRAC)
#POLIDS_AIP_IFR_URL=https://docs.pansa.pl/ais/eaipifr/AIRAC%20AMDT%2010-26_2026_10_01/index-v2.html
#POLIDS_AIP_VFR_URL=https://docs.pansa.pl/ais/eaipvfr/AIRAC%20AMDT%20VFR%2010-26_2026_10_01/index-v2.html
#POLIDS_AIP_MIL_URL=https://docs.pansa.pl/ais/eaipmil/AIRAC%20AMDT%20MIL%2010-26_2026_10_01/index-v2.html

# Serwer NOTAM PL vACC
#POLIDS_NOTAM_SERVER=https://cv.plvacc.pl/
#POLIDS_NOTAM_PREFIX=notam/get-icao-format?icao=
#POLIDS_NOTAM_SUFFIX=&read=true

# Nakładka lotnicza na mapie (darmowy klucz z https://www.openaip.net)
#POLIDS_OPENAIP_API_KEY=

# Klucz CARTO do podkładów mapy (ciemny / jasny), darmowy z https://carto.com/basemaps/apikey.
# Bez klucza CARTO dodaje znak wodny, więc aplikacja używa wtedy szarego podkładu Esri.
# Wpisz go tylko tutaj, w lokalnym pliku .env (jest w .gitignore), nigdy w repozytorium.
#POLIDS_CARTO_API_KEY=

# vIFF (VATSIM IFPS/ETFMS/CDM): odloty z EOBT/CTOT/statusem i przepustowość sektorów. Odczyt działa bez klucza;
# klucz wpisz tylko, jeśli dostaniesz go od autora vIFF (wysyłany jako nagłówek x-api-key).
#POLIDS_VIFF_URL=https://api.viffsys.com
#POLIDS_VIFF_API_KEY=
#POLIDS_VIFF_CDM_AIRPORTS=EPWA
